{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sverigespelet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Bara API:t går via Worker-scriptet; allt annat serveras direkt som statiska filer.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sverigespelet",
      "database_id": "e0179868-6c4d-4e28-8689-31565b91c2f7",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    // Ett objekt per live-rum (se worker/live.ts).
    "bindings": [{ "name": "LIVE_ROOM", "class_name": "LiveRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "ratelimits": [
    {
      // Begränsar hur ofta en IP-adress kan spara resultat och skapa live-rum.
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
