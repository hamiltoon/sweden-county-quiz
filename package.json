{
  "name": "sverigespelet",
  "version": "0.1.0",
  "description": "Geografispel om Sveriges län och residensstäder",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "preview:cf": "npm run build && npm run db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply sverigespelet --local",
    "db:migrate:remote": "wrangler d1 migrations apply sverigespelet --remote",
    "typecheck": "tsc --noEmit && tsc -p worker --noEmit"
  },
  "keywords": [],
  "author": "John Mårtensson",
  "license": "MIT",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "qrcode-generator": "2.0.4",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
